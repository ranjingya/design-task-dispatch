# 飞书自建应用
FEISHU_DATA_APP_ID=
FEISHU_DATA_APP_SECRET=

# 私聊通知使用的应用机器人，需启用机器人及 im:message:send_as_bot 权限
FEISHU_ALERT_APP_ID=
FEISHU_ALERT_APP_SECRET=

# 需求任务表
FEISHU_BASE_TOKEN=
FEISHU_TABLE_ID=

# 自动化请求头 X-Webhook-Token 的值
WEBHOOK_TOKEN=

# 本地运行时可省略；Docker 中由 compose 设置为 /app/config/fields.json
# FIELD_MAPPING_PATH=config/fields.json

# 与需求表位于同一 Base 的 ABC 规则表
FEISHU_RULES_TABLE_ID=

# DeepSeek 兼容接口，地址可包含 /v1，不包含 /chat/completions
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_ATTEMPTS=3
AI_MAX_OUTPUT_TOKENS=16384

# 容器默认从 /app/prompts/classify.md 读取
# CLASSIFY_PROMPT_PATH=prompts/classify.md
# RULE_FIELD_MAPPING_PATH=config/rule_fields.json
MAX_IMAGES=32
MAX_IMAGE_BYTES=10485760
MAX_TOTAL_IMAGE_BYTES=20971520

# 本地默认 .cache/rules.json；Docker 使用持久化卷 /app/cache/rules.json
# RULES_CACHE_PATH=.cache/rules.json

# 成员负荷表（与需求任务表同一 Base）
FEISHU_MEMBERS_TABLE_ID=
FEISHU_STATISTICS_TABLE_ID=
# 商品数据包分配表（可位于另一个 Base）
FEISHU_PRODUCT_BASE_TOKEN=
FEISHU_PRODUCT_TABLE_ID=

# 附件与在线电子表格解析配置
# MATERIALS_CONFIG_PATH=/app/config/materials.json

# 本地日志目录；Docker Compose 使用 /app/logs
LOG_DIR=logs
